# URL completa de la DB
DATABASE_URL=postgresql+psycopg://myuser:mypassword123@localhost:5433/myapp_db

# Credenciales de Postgres (requeridas por docker-compose)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword123
POSTGRES_DB=myapp_db

# Panel de BD (requerido por docker-compose)
PGADMIN_EMAIL=admin@ejemplo.com
PGADMIN_PASSWORD=adminseguro

# Seguridad y JWT
SECRET_KEY=tu_clave_super_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS y Frontend
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cloudinary key
CLOUDINARY_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- MercadoPago (sandbox) ---
# Usar credenciales de prueba (TEST), NUNCA las de producción.
MP_ACCESS_TOKEN=TEST-tu-access-token-de-mercadopago
MP_PUBLIC_KEY=TEST-tu-public-key-de-mercadopago

# --- Webhooks (Ngrok) ---
# URL pública de ngrok para back_urls HTTPS y recibir notificaciones.
NGROK_URL=https://tu-subdominio.ngrok-free.app
MP_WEBHOOK_URL=https://tu-subdominio.ngrok-free.app/api/v1/pagos/webhook
