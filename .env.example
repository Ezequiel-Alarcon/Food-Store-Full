DATABASE_URL=postgresql+psycopg://myuser:mypassword123@localhost:5432/myapp_db

# Opcional si la base de datos no esta definida
# POSTGRES_USER=myuser
# POSTGRES_PASSWORD=mypassword123
# POSTGRES_DB=myapp_db

# Seguridad
# SECRET_KEY=
# ALGORITHM=
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary key
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- MercadoPago (sandbox) ---
# Usar credenciales de prueba (TEST), NUNCA las de producción.
# MP_ACCESS_TOKEN=TEST-tu-access-token-de-mercadopago
# MP_PUBLIC_KEY=TEST-tu-public-key-de-mercadopago

# --- Webhooks (Ngrok) ---
# URL pública de ngrok para back_urls HTTPS y recibir notificaciones.
# NGROK_URL=https://tu-subdominio.ngrok-free.app
# MP_WEBHOOK_URL=https://tu-subdominio.ngrok-free.app/api/v1/pagos/webhook
