@baseUrl = http://127.0.0.1:8000

### ==========================================
### FLUJO CASCADA BACKEND - Food Store Full
### Ejecutar de arriba hacia abajo sin cambios
### Asume base relativamente limpia
### ==========================================

### ==========================================
### 0. AUTENTICACIÓN Y PREPARACIÓN
### ==========================================

### 0.1 Registro de usuario cliente (para pedidos)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "nombre": "Test",
  "apellido": "Cliente",
  "email": "cliente.test@example.com",
  "password": "test1234",
  "celular": "+5411111111"
}

### 0.2 Login para obtener token
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/x-www-form-urlencoded

username=cliente.test@example.com&password=test1234

### 0.3 Login como admin (para operaciones privileged)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/x-www-form-urlencoded

username=admin@example.com&password=admin123


### ==========================================
### 1. CATEGORIAS (Dominio 2)
### ==========================================

### 1.1 Crear Categoria 1 - Root (requiere ADMIN)
POST {{baseUrl}}/api/v1/categorias/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Bebidas",
  "descripcion": "Categoria principal de bebidas",
  "imagen_url": "http://img/bebidas",
  "parent_id": null
}

### 1.2 Crear Categoria 2 - Hija de Bebidas
POST {{baseUrl}}/api/v1/categorias/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Cafe",
  "descripcion": "Subcategoria de bebidas",
  "imagen_url": "http://img/cafe",
  "parent_id": 1
}

### 1.3 Crear Categoria 3 - Otra principal
POST {{baseUrl}}/api/v1/categorias/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Panaderia",
  "descripcion": "Categoria secundaria",
  "imagen_url": "http://img/panaderia",
  "parent_id": null
}

### 1.4 Listar Categorias (con paginación)
GET {{baseUrl}}/api/v1/categorias/?offset=0&limit=10

### 1.5 Listar Categorias Principales
GET {{baseUrl}}/api/v1/categorias/?is_principal=true&offset=0&limit=10

### 1.6 Ver Arbol de Categorias
GET {{baseUrl}}/api/v1/categorias/arbol

### 1.7 Obtener Categoria 1
GET {{baseUrl}}/api/v1/categorias/1

### 1.8 Ver Subcategorias de Categoria 1
GET {{baseUrl}}/api/v1/categorias/1/subcategorias?offset=0&limit=10

### 1.9 Actualizar Categoria 2
PATCH {{baseUrl}}/api/v1/categorias/2
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "descripcion": "Subcategoria de cafe y bebidas calientes"
}


### ==========================================
### 2. INGREDIENTES (Dominio 2)
### ==========================================

### 2.1 Crear Ingrediente 1
POST {{baseUrl}}/api/v1/ingredientes/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Azucar",
  "descripcion": "Ingrediente endulzante",
  "es_alergeno": true
}

### 2.2 Crear Ingrediente 2
POST {{baseUrl}}/api/v1/ingredientes/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Cafe Molido",
  "descripcion": "Ingrediente principal para cafe",
  "es_alergeno": false
}

### 2.3 Listar Ingredientes (paginado)
GET {{baseUrl}}/api/v1/ingredientes/?offset=0&limit=10

### 2.4 Listar Ingredientes Alergenos
GET {{baseUrl}}/api/v1/ingredientes/?is_alergeno=true&offset=0&limit=10

### 2.5 Obtener Ingrediente 1
GET {{baseUrl}}/api/v1/ingredientes/1

### 2.6 Actualizar Ingrediente 1
PATCH {{baseUrl}}/api/v1/ingredientes/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "descripcion": "Ingrediente endulzante actualizado"
}


### ==========================================
### 3. PRODUCTOS (Dominio 2)
### ==========================================

### 3.1 Crear Producto 1 (con categorias e ingredientes)
POST {{baseUrl}}/api/v1/productos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Cafe Latte",
  "descripcion": "Cafe con leche cremado",
  "precio_base": 1200.00,
  "imagenes_url": ["http://img/latte"],
  "stock_cantidad": 15,
  "disponible": true,
  "categoria_ids": [2],
  "ingredientes": [
    { "ingrediente_id": 1, "es_removible": false },
    { "ingrediente_id": 2, "es_removible": true }
  ]
}

### 3.2 Crear Producto 2 (con multiples categorias)
POST {{baseUrl}}/api/v1/productos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Cafe Negro con Medialuna",
  "descripcion": "Combo cafe negro y medialuna",
  "precio_base": 900.00,
  "imagenes_url": ["http://img/negro"],
  "stock_cantidad": 20,
  "disponible": true,
  "categoria_ids": [2, 3],
  "ingredientes": [
    { "ingrediente_id": 2, "es_removible": false }
  ]
}

### 3.3 Listar Productos
GET {{baseUrl}}/api/v1/productos/?offset=0&limit=10

### 3.4 Obtener Producto 1
GET {{baseUrl}}/api/v1/productos/1

### 3.5 Filtrar Productos por Categoria
GET {{baseUrl}}/api/v1/productos/?categoria_ids=2&offset=0&limit=10

### 3.6 Buscar Productos por nombre
GET {{baseUrl}}/api/v1/productos/?q=Cafe&offset=0&limit=10

### 3.7 Actualizar Producto 1
PATCH {{baseUrl}}/api/v1/productos/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "precio_base": 1350.00,
  "stock_cantidad": 12,
  "categoria_ids": [1, 2],
  "ingredientes": [
    { "ingrediente_id": 2, "es_removible": true }
  ]
}

### 3.8 Cambiar disponibilidad de Producto 2
PATCH {{baseUrl}}/api/v1/productos/2/disponibilidad
Authorization: Bearer {{token}}

### 3.9 Error: Crear producto sin categoria (debe fallar con 400)
POST {{baseUrl}}/api/v1/productos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Producto Invalido",
  "precio_base": 100.00,
  "categoria_ids": []
}


### ==========================================
### 4. UNIDADES DE MEDIDA (Dominio 2)
### ==========================================

### 4.1 Crear Unidad de Medida
POST {{baseUrl}}/api/v1/unidades-medida/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Kilogramo",
  "abreviatura": "kg",
  "descripcion": "Unidad de masa"
}

### 4.2 Listar Unidades de Medida
GET {{baseUrl}}/api/v1/unidades-medida/?offset=0&limit=10

### 4.3 Obtener Unidad de Medida 1
GET {{baseUrl}}/api/v1/unidades-medida/1

### 4.4 Actualizar Unidad de Medida 1
PATCH {{baseUrl}}/api/v1/unidades-medida/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "descripcion": "Unidad de masa actualizada"
}


### ==========================================
### 5. DIRECCIONES DE ENTREGA (Dominio 1)
### ==========================================

### 5.1 Crear Direccion de Entrega (requiere auth)
POST {{baseUrl}}/api/v1/direcciones/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "calle": "Av. Rivadavia",
  "numero": "1234",
  "piso": "3",
  "departamento": "B",
  "ciudad": "Buenos Aires",
  "provincia": "CABA",
  "codigo_postal": "1001",
  "referencia": "Entre Calles"
}

### 5.2 Crear Segunda Direccion
POST {{baseUrl}}/api/v1/direcciones/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "calle": "Av. Santa Fe",
  "numero": "5678",
  "piso": null,
  "departamento": null,
  "ciudad": "Buenos Aires",
  "provincia": "CABA",
  "codigo_postal": "1050",
  "referencia": "Porton rojo"
}

### 5.3 Listar Mis Direcciones
GET {{baseUrl}}/api/v1/direcciones/
Authorization: Bearer {{token}}

### 5.4 Actualizar Direccion 1
PATCH {{baseUrl}}/api/v1/direcciones/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "referencia": "Entre Calles - Actualizado"
}

### 5.5 Marcar Direccion 2 como Principal
PATCH {{baseUrl}}/api/v1/direcciones/2/principal
Authorization: Bearer {{token}}


### ==========================================
### 6. PEDIDOS (Dominio 3)
### ==========================================

### 6.1 Crear Pedido (CLIENT) - Verificar que exista forma de pago primero
POST {{baseUrl}}/api/v1/pedidos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "direccion_id": 1,
  "forma_pago_codigo": "EFECTIVO",
  "notas": "Sin azucar, por favor",
  "items": [
    {
      "producto_id": 1,
      "cantidad": 2,
      "personalizacion": null
    },
    {
      "producto_id": 2,
      "cantidad": 1,
      "personalizacion": null
    }
  ]
}

### 6.2 Listar Mis Pedidos (CLIENT)
GET {{baseUrl}}/api/v1/pedidos/mis-pedidos
Authorization: Bearer {{token}}

### 6.3 Obtener Mi Pedido (CLIENT)
GET {{baseUrl}}/api/v1/pedidos/mis-pedidos/1
Authorization: Bearer {{token}}

### 6.4 Listar Todos los Pedidos (ADMIN/PEDIDOS)
GET {{baseUrl}}/api/v1/pedidos/?offset=0&limit=10
Authorization: Bearer {{token}}

### 6.5 Obtener Pedido por ID (ADMIN/PEDIDOS)
GET {{baseUrl}}/api/v1/pedidos/1
Authorization: Bearer {{token}}

### 6.6 Obtener Historial de Estados del Pedido (ADMIN/PEDIDOS)
GET {{baseUrl}}/api/v1/pedidos/1/historial
Authorization: Bearer {{token}}

### 6.7 Cambiar Estado del Pedido (ADMIN/PEDIDOS)
PATCH {{baseUrl}}/api/v1/pedidos/1/estado
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "estado_hacia": "CONFIRMADO",
  "motivo": "Pago confirmado"
}

### 6.8 Cambiar a otro estado (ADMIN/PEDIDOS)
PATCH {{baseUrl}}/api/v1/pedidos/1/estado
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "estado_hacia": "EN_PREPARACION",
  "motivo": "Comenzando preparacion"
}

### 6.9 Cancelar Mi Pedido (CLIENT)
PATCH {{baseUrl}}/api/v1/pedidos/mis-pedidos/1/cancelar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "estado_hacia": "CANCELADO",
  "motivo": "Cambie de opinion"
}

### 6.10 Crear Segundo Pedido
POST {{baseUrl}}/api/v1/pedidos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "direccion_id": 2,
  "forma_pago_codigo": "MERCADO_PAGO",
  "notas": null,
  "items": [
    {
      "producto_id": 1,
      "cantidad": 1,
      "personalizacion": null
    }
  ]
}

### 6.11 Error: Crear pedido SIN items (debe fallar 400)
POST {{baseUrl}}/api/v1/pedidos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "forma_pago_codigo": "EFECTIVO",
  "items": []
}

### 6.12 Error: Crear pedido con forma_pago inexistente (debe fallar 400)
POST {{baseUrl}}/api/v1/pedidos/
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "forma_pago_codigo": "NO_EXISTE",
  "items": [
    {
      "producto_id": 1,
      "cantidad": 1,
      "personalizacion": null
    }
  ]
}

### 6.13 Eliminar Pedido (ADMIN - soft delete)
DELETE {{baseUrl}}/api/v1/pedidos/2
Authorization: Bearer {{token}}


### ==========================================
### 7. USUARIOS (Dominio 1)
### ==========================================

### 7.1 Obtener Mi Perfil
GET {{baseUrl}}/api/v1/usuarios/me
Authorization: Bearer {{token}}

### 7.2 Actualizar Mi Perfil
PATCH {{baseUrl}}/api/v1/usuarios/me
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Test Updated",
  "celular": "+5491111111111"
}

### 7.3 Listar Todos los Usuarios (ADMIN)
GET {{baseUrl}}/api/v1/admin/usuarios/?offset=0&limit=10
Authorization: Bearer {{token}}

### 7.4 Crear Usuario por Admin (ADMIN)
POST {{baseUrl}}/api/v1/admin/usuarios/createUser
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "New",
  "apellido": "User",
  "email": "new.user@example.com",
  "password": "password123",
  "celular": "+5492222222222",
  "roles_codigos": ["CLIENT"]
}

### 7.5 Actualizar Usuario por Admin (ADMIN)
PATCH {{baseUrl}}/api/v1/admin/usuarios/2
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "roles_codigos": ["CLIENT", "PEDIDOS"]
}


### ==========================================
### 8. LIMPIEZA
### ==========================================

### 8.1 Eliminar Producto 2
DELETE {{baseUrl}}/api/v1/productos/2
Authorization: Bearer {{token}}

### 8.2 Eliminar Producto 1
DELETE {{baseUrl}}/api/v1/productos/1
Authorization: Bearer {{token}}

### 8.3 Eliminar Ingrediente 2
DELETE {{baseUrl}}/api/v1/ingredientes/2
Authorization: Bearer {{token}}

### 8.4 Eliminar Ingrediente 1
DELETE {{baseUrl}}/api/v1/ingredientes/1
Authorization: Bearer {{token}}

### 8.5 Eliminar Unidad de Medida 1
DELETE {{baseUrl}}/api/v1/unidades-medida/1

### 8.6 Eliminar Categoria 3
DELETE {{baseUrl}}/api/v1/categorias/3
Authorization: Bearer {{token}}

### 8.7 Eliminar Categoria 2
DELETE {{baseUrl}}/api/v1/categorias/2
Authorization: Bearer {{token}}

### 8.8 Eliminar Categoria 1
DELETE {{baseUrl}}/api/v1/categorias/1
Authorization: Bearer {{token}}

### 8.9 Eliminar Direccion 2
DELETE {{baseUrl}}/api/v1/direcciones/2
Authorization: Bearer {{token}}

### 8.10 Eliminar Direccion 1
DELETE {{baseUrl}}/api/v1/direcciones/1
Authorization: Bearer {{token}}