# =============================================================================
# .env.test — Variables de entorno para la SUITE DE TESTS
# =============================================================================

ENVIRONMENT=test

TEST_DATABASE_URL=sqlite:///:memory:
DATABASE_URL=sqlite:///:memory:

# JWT
SECRET_KEY=test-secret-key-fija-para-tests-no-usar-en-produccion-min-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary (Mockeado para tests)
CLOUDINARY_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

# Logging
LOG_LEVEL=WARNING

# Rate Limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_BURST=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AUTH_BURST=5
